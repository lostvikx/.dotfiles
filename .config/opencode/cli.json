{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "scroll": {
    "speed": 3,
    "acceleration": false
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto",
    "verbosity": "medium",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "cursor": {
    "blinking": false
  },
  "animations": true,
  "mouse": true,
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "indicators": "status"
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": false,
    "volume": 0.5
  },
  "debug": {
    "devtools": false
  }
}
