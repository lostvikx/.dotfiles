{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin",
    "mode": "dark"
  },
  "scroll": {
    "speed": 3,
    "acceleration": false
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "terminal": {
    "title": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "cursor": {
    "blinking": false
  },
  "animations": true,
  "mouse": true
}
