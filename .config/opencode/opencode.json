{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "autoupdate": true,
  "formatter": true,
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "webfetch": "allow"
  },
  "provider": {
    "anthropic": {
      "options": {
        "timeout": 60000,
        "chunkTimeout": 30000
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:0.8b": {
          "name": "Qwen 3.5 0.8B"
        }
      }
    }
  },
  "default_agent": "plan",
  "compaction": {
    "auto": true
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    }
  }
}
