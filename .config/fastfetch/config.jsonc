{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 20,
        "width": 20,
        "padding": {
            "top": 3,
            "left": 2
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────── Hardware ──────────────────────┐"
        },
        {
            "type": "host",
            "key": "  󰌢  pc  ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "    cpu ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "  󰍹  gpu ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "  󰑭  ram ",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "  󰋊  ssd ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────── Software ──────────────────────┐"
        },
        {
            "type": "os",
            "key": "    os  ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "  󰌽  krn ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "  󰏗  pkg ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "  󰞷  shl ",
            "keyColor": "yellow"
        },
        {
            "type": "de",
            "key": "  󰧨  de  ",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "  󰍁  lm  ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "  󱂬  wm  ",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "  󰉦  wm  ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "  󰆍  ter ",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────── Assorted ──────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  age ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  up  ",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": "  ›  dt  ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└──────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
